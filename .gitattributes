# Normalise line endings in the repository to LF.
# CC:Tweaked runs Lua on a Linux-like VM and the installer is fetched over
# HTTP; CRLF in Lua sources is undesirable, so keep the repository LF-only.
* text=auto eol=lf

# Binary fixtures must never be line-ending converted.
# Only .nbs is used (the fixture/corpus format).  This project ships no audio
# files of any kind -- it only schedules note calls -- so there are no
# *.dfpwm / *.ogg / *.wav attributes to declare here.
*.nbs binary

# Windows-only helper scripts keep native CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf


