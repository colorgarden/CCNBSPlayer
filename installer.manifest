# CCNBSPlayer installer manifest (format v1)
#
# One repository-relative path per line. Blank lines and lines whose first
# non-space character is '#' are ignored; surrounding whitespace is trimmed;
# duplicates are dropped (order preserved). Plain text -- no JSON, no quoting.
# Parsed on the computer by installer.parse_manifest(text).
#
# The installer fetches this file from the repository base FIRST and installs
# exactly these paths. If it cannot be fetched, installer.RUNTIME_FILES stands
# in. tests/installer_manifest_spec.lua fails if EITHER list stops covering
# every module the runtime `require`s, and if any entry here names a file that
# does not exist. Runtime modules only: no tests/**, no scripts.

# Entry programs (must sit beside the modules under /lib so require resolves).
# installer.lua is shipped because the updater requires it: /lib/updater does
# `require("installer")`, so a fresh install MUST write /lib/installer.lua or the
# command the README tells users to run dies on `module 'installer' not found`.
ccnbs.lua
ccnbsplayer.lua
updater.lua
installer.lua

# NBS decode/analyze modules.
nbs/analyze.lua
nbs/cp1252.lua
nbs/decode.lua
nbs/header.lua
nbs/instrument_table.lua
nbs/instruments_custom.lua
nbs/layers.lua
nbs/notes.lua
nbs/reader.lua
nbs/speakers.lua

# Player runtime modules.
player/clock.lua
player/dispatch.lua
player/fanout.lua
player/mapping.lua
player/plan.lua
player/runtime.lua
player/speaker.lua
player/tempo.lua
player/warnings.lua

# Net modules required by the runtime.
net/http.lua
net/nbw.lua
net/zip.lua

# UI layer: the Basalt app entry point, the i18n tables, the installer's Basalt
# view and the presentation logic.
ui/basalt_app.lua
ui/cjk.lua
ui/i18n.lua
ui/installer_app.lua
ui/presenter.lua

# Vendored third-party bundles the runtime loads (see vendor/README.md).
vendor/basalt.lua
vendor/utf8display.lua

# The interface: the shell, its screens, and the local stores.
ui/icons.lua
ui/settings.lua
ui/history.lua
ui/ime.lua
ui/songs.lua
ui/transport.lua
ui/app_shell.lua
ui/screens/frame.lua
ui/screens/collection.lua
ui/screens/home.lua
ui/screens/browse.lua
ui/screens/library.lua
ui/screens/detail.lua
ui/screens/nowplaying.lua
ui/screens/queue.lua
ui/screens/settings.lua
ui/screens/about.lua
ui/screens/help.lua

# Icons, read by PATH rather than required -- so the drift guard
# cannot see them and they must be listed by hand.
vendor/mplayer-icons/Album.lua
vendor/mplayer-icons/Discover.lua
vendor/mplayer-icons/Favorite.lua
